Bootstrap: docker
From: python:3.12-slim-bookworm

%environment
    export XDG_CACHE_HOME=/tmp/.cache
    export MPLCONFIGDIR=/tmp/matplotlib
    export NUMBA_CACHE_DIR=/tmp/numba-cache

%post
    # Nextflow uses `ps` inside task containers to collect process metrics.
    # The python:*‑slim base image intentionally omits procps.
    apt-get update
    apt-get install -y --no-install-recommends procps
    rm -rf /var/lib/apt/lists/*

    python -m pip install --no-cache-dir --upgrade pip
    python -m pip install --no-cache-dir "scanpy==1.12.4"

%test
    # Catch the two runtime capabilities Norn/Nextflow actually need.
    command -v ps >/dev/null
    python - <<'PY'
from importlib.metadata import version
import anndata as ad
import numpy as np
import scanpy  # noqa: F401

print("scanpy", version("scanpy"))
probe = ad.AnnData(X=np.array([[1]], dtype=np.float32))
probe.write_h5ad("/tmp/norn-scanpy-probe.h5ad")
PY
