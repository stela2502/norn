nextflow_process {
    name "Test BUILD_STAR_INDEX"
    script "../modules/local/build_star_index.nf"
    process "BUILD_STAR_INDEX"

    test("BUILD_STAR_INDEX output contract (stub)") {
        options "-stub"
        when {
            def fixture = new File(launchDir.toString(), "build_star_index-fixture")
            fixture.mkdirs()
            def genome = new File(fixture, "test.fa"); genome.text = ">chr1\nACGT\n"
            def gtf = new File(fixture, "test.gtf"); gtf.text = "stub"

            process {
                """
                input[0] = Channel.value(file('${genome.absolutePath}'))
                input[1] = Channel.value(file('${gtf.absolutePath}'))
                input[2] = Channel.value('${outputDir}/indexes')
                input[3] = Channel.value('star')
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.index.size() == 1 },
                { assert file("${process.out.index[0]}/Genome").exists() },
                { assert file("${process.out.index[0]}/SAindex").exists() }
            )
        }
    }
}
