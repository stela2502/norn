params {
    outdir = 'test-results'
    publish_mode = 'copy'
    reference_publish_mode = 'copy'
    health_server = false
}

process {
    executor = 'local'

    // Test fixtures and stub commands are deliberately tiny.  Override the
    // production resource selectors so local nf-test runs do not require a
    // cluster-sized machine merely to exercise workflow wiring.
    withName: BUILD_STAR_INDEX {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
    withName: BUILD_SPLICE_INDEX {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
    withName: BUILD_VDJ_INDEX {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
    withName: NELRUNE_PREPARE {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
    withName: STAR_ALIGN {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
    withName: NELRUNE_QUANT {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
    withName: NELRUNE_VDJ {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
}
