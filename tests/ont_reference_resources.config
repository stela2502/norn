// Tiny synthetic ONT reference: override production memory requirements only for this test.
process {
    withName: BUILD_MINIMAP2_INDEX {
        cpus = 2
        memory = '2 GB'
    }
    withName: BUILD_STAR_INDEX {
        cpus = 2
        memory = '2 GB'
    }
    withName: NELRUNE_ONT {
        // Fixture must fail on a mapper error, not continue to a missing-GTF assertion.
        errorStrategy = 'finish'
        memory = '8 GB'
    }
}
