nextflow.enable.dsl=2

params {
    samplesheet       = null
    outdir            = 'results'

    // Primary reference inputs. These are enough for the default STAR/Lumrik
    // reference-preparation branch.
    genome            = null
    gtf               = null

    // Optional escape hatches. Normally leave these unset and let Norn build them.
    mapper_index      = null
    splice_index      = null
    vdj_index         = null

    // Nelrune mapper / input controls. R1/R2, mapper index, splice index and
    // outpath remain Norn-owned because they are workflow inputs/outputs.
    mapper                    = 'star'
    mapper_bin                = null
    mapper_options            = null
    mapper_threads            = 8
    mapper_paired             = false
    mapper_keep_multimappers  = false
    nelrune_prepare_threads   = 8
    nelrune_quant_threads     = 8

    primer_structure          = null
    whitelist                 = null
    whitelist_mismatches      = 1
    detect_reverse_complement = false

    // Quantification / assignment controls.
    quant_mode                   = 'gene'
    min_mapq                     = 0
    max_reads                    = null
    read1_only                   = false
    no_genome_refine             = false
    require_strand               = false
    require_exact_junction_chain = false
    max_5p_overhang_bp           = 0
    max_3p_overhang_bp           = 0
    allowed_intronic_gap_size    = 0
    snp_min_anchor               = 5
    vcf                          = null

    // Optional external read-tag metadata. Multiple tables may be supplied as a
    // comma-separated string.
    read_tag_table              = null
    rt_read_id_column           = 'read_id'
    rt_cell_column              = 'raw_cb'
    rt_cell_qual_column         = 'quality_cb'
    rt_umi_column               = 'raw_umi'
    rt_umi_qual_column          = 'quality_umi'
    rt_original_read_id_column = 'original_read_id'
    analysis_type               = 'single-cell'
    cell_tag                    = 'CB'
    umi_tag                     = 'UB'
    bam_out                     = null

    // Supplemental short features. Built-ins: bd_sample_human, bd_sample_mouse.
    // Multiple sources may be supplied as a comma-separated string.
    additional_features         = null
    additional_feature_min_hits = 20
    min_insert_len              = 20
    min_transcript_len          = 20
    min_cell_counts             = 400

    // Stage-specific escape hatches for future Nelrune CLI options.
    nelrune_prepare_extra_args  = ''
    nelrune_quant_extra_args    = ''

    // Live Lumrik dashboards. Each parallel task gets its own predictable port.
    health_server            = true
    nelrune_health_port_base = 8787
    vdj_health_port_base     = 18787

    // Publishing large sample/reference assets as hard links avoids needless copies
    // when work/ and results/ are on the same filesystem.
    publish_mode           = 'link'
    reference_publish_mode = 'link'

    run_vdj                  = true
    vdj_write_sequences      = false
    vdj_threads              = 8
    vdj_min_sequence_overlap = 12
    // null derives v1/v2.96/v2.384 from the sample chemistry.
    vdj_bd_cell_version      = null
    // Escape hatch for future nelrune-vdj CLI options.
    nelrune_vdj_extra_args   = ''

    // Pin this to a released Lumrik runtime image in production.
    container           = 'ghcr.io/stela2502/lumrik:v0.6.0'
}

process {
    container = params.container
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: BUILD_STAR_INDEX {
        cpus = 8
        memory = '40 GB'
        time = '12h'
    }
    withName: BUILD_SPLICE_INDEX {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }
    withName: BUILD_VDJ_INDEX {
        cpus = 2
        memory = '8 GB'
        time = '4h'
    }
    withName: NELRUNE_PREPARE {
        cpus = { params.nelrune_prepare_threads as int }
        memory = '24 GB'
        time = '24h'
    }
    withName: STAR_ALIGN {
        cpus = { params.mapper_threads as int }
        memory = '40 GB'
        time = '24h'
    }
    withName: NELRUNE_QUANT {
        cpus = { params.nelrune_quant_threads as int }
        memory = '24 GB'
        time = '24h'
    }
    withName: NELRUNE_VDJ {
        cpus = { params.vdj_threads as int }
        memory = '16 GB'
        time = '12h'
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
