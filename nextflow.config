nextflow.enable.dsl=2

params {
    samplesheet       = null
    outdir            = 'results'

    // Primary reference inputs. These are enough for the default STAR/Lumrik
    // reference-preparation branch.
    genome            = null
    gtf               = null

    // Optional escape hatches. Normally leave these unset and let Norn build them.
    mapper_index      = null
    splice_index      = null
    vdj_index         = null

    mapper            = 'star'
    mapper_threads    = 8
    nelrune_threads   = 8
    min_cell_counts   = 400
    // Optional per-input FASTQ read limit for quick debugging/smoke tests.
    // null means process all reads.
    max_reads         = null

    // Live Lumrik dashboards. Each parallel task gets its own predictable port.
    health_server            = true
    nelrune_health_port_base = 8787
    vdj_health_port_base     = 18787

    // Publishing large sample/reference assets as hard links avoids needless copies
    // when work/ and results/ are on the same filesystem.
    publish_mode           = 'link'
    reference_publish_mode = 'link'

    run_vdj             = true
    vdj_write_sequences = false
    vdj_threads         = 8

    // Convenience Seurat v5 object. The core Lumrik outputs remain unchanged.
    make_seurat         = true
    seurat_container    = 'satijalab/seurat:5.5.1'

    // Convenience Scanpy/AnnData object with the same RNA/VDJ semantics.
    make_scanpy         = true
    // Norn-owned, pinned Scanpy runtime. NORN_SCANPY_CONTAINER can point at a
    // local SIF for development/testing without changing the pipeline config.
    scanpy_container    = System.getenv('NORN_SCANPY_CONTAINER') ?: 'ghcr.io/stela2502/norn-scanpy:1.12.4-2'
    // Pin this to a released Lumrik runtime image in production.
    container           = 'ghcr.io/stela2502/lumrik:v0.2.2'
}

process {
    container = params.container
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: BUILD_STAR_INDEX {
        cpus = 8
        memory = '40 GB'
        time = '12h'
    }
    withName: BUILD_SPLICE_INDEX {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }
    withName: BUILD_VDJ_INDEX {
        cpus = 2
        memory = '8 GB'
        time = '4h'
    }
    withName: NELRUNE {
        cpus = { Math.max(params.nelrune_threads as int, params.mapper_threads as int) }
        memory = '48 GB'
        time = '24h'
    }
    withName: NELRUNE_VDJ {
        cpus = { params.vdj_threads as int }
        memory = '16 GB'
        time = '12h'
    }
    withName: CREATE_SEURAT {
        cpus = 2
        memory = '24 GB'
        time = '4h'
    }
    withName: CREATE_SCANPY {
        cpus = 2
        memory = '24 GB'
        time = '4h'
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
