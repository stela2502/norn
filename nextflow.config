nextflow.enable.dsl=2

params {
    samplesheet       = null
    outdir            = 'results'

    // Primary reference inputs. These are enough for the default STAR/Lumrik
    // reference-preparation branch.
    genome            = null
    gtf               = null

    // Optional escape hatches. Normally leave these unset and let Norn build them.
    mapper_index      = null
    splice_index      = null
    vdj_index         = null

    mapper            = 'star'
    mapper_threads    = 8
    nelrune_threads   = 8
    min_cell_counts   = 400

    // Publishing large sample/reference assets as hard links avoids needless copies
    // when work/ and results/ are on the same filesystem.
    publish_mode           = 'link'
    reference_publish_mode = 'link'

    run_vdj             = true
    vdj_write_sequences = false
    vdj_bam_shards      = null
    // Pin this to a released Lumrik runtime image in production.
    container           = 'ghcr.io/stela2502/lumrik:v0.1.4'
}

process {
    container = params.container
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: BUILD_STAR_INDEX {
        cpus = 8
        memory = '40 GB'
        time = '12h'
    }
    withName: BUILD_SPLICE_INDEX {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }
    withName: BUILD_VDJ_INDEX {
        cpus = 2
        memory = '8 GB'
        time = '4h'
    }
    withName: NELRUNE {
        cpus = { Math.max(params.nelrune_threads as int, params.mapper_threads as int) }
        memory = '48 GB'
        time = '24h'
    }
    withName: NELRUNE_VDJ {
        cpus = 4
        memory = '16 GB'
        time = '12h'
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}
